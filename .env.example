# Access mode: standalone or portal. Portal also requires the broker to send
# X-MADPANDA-PORTAL-SUBJECT with a stable tenant identity on every MCP request.
MCP_MODE=standalone
MCP_ACCESS_TOKEN=
MCP_PORTAL_GRANT_TOKEN=
MCP_PORTAL_GRANT_HEADER=X-MADPANDA-PORTAL-GRANT
MCP_PRINCIPAL_HASH_SECRET=

# HTTP trust boundary
MCP_BIND_ADDRESS=0.0.0.0
MCP_HTTP_PORT=8087
MCP_HOST_PORT=8087
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],ffmpeg-mcp
MCP_ALLOWED_ORIGINS=
MCP_REQUEST_BODY_MAX_BYTES=131072
MCP_REQUEST_BODY_TIMEOUT_SECONDS=10
MCP_RESPONSE_BODY_MAX_BYTES=2097152
MCP_RATE_LIMIT_PRINCIPAL_RPM=300
MCP_RATE_LIMIT_WINDOW_SECONDS=60
MCP_RATE_LIMIT_RETRY_AFTER_SECONDS=60

# Authenticated Redis. REDIS_PASSWORD must be URL-safe for the supplied Compose files.
REDIS_PASSWORD=
REDIS_URL=redis://:REPLACE_WITH_URL_SAFE_PASSWORD@redis:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=5
# Hard-capped at 192 MiB; supplied containers allow 512 MiB for AOF/COW headroom.
REDIS_MAXMEMORY_BYTES=201326592
QUEUE_NAME=av-jobs
QUEUE_NAME_URGENT=
QUEUE_NAME_BATCH=
QUEUE_NAMES=

# Shared media storage
STORAGE_BACKEND=local
# Compose defaults; direct Python deployments may choose other disjoint paths.
STORAGE_LOCAL_DIR=/data/assets
STORAGE_TEMP_DIR=/data/staging
# Reap only stale top-level regular staging files; must exceed every ingest/job timeout.
STORAGE_STAGING_MAX_AGE_SECONDS=7200
# Remote URL/Drive ingest reserves MAX_INGEST_BYTES before network I/O. These
# durable Redis leases are independent from retained managed-asset quotas.
INGEST_STAGING_OWNER_MAX_ACTIVE=2
INGEST_STAGING_GLOBAL_MAX_ACTIVE=8
INGEST_STAGING_OWNER_MAX_BYTES=1000000000
INGEST_STAGING_GLOBAL_MAX_BYTES=4000000000
INGEST_STAGING_LEASE_SECONDS=600
INGEST_STAGING_HEARTBEAT_SECONDS=30
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_CONNECT_TIMEOUT_SECONDS=10
S3_READ_TIMEOUT_SECONDS=60

# Bounded storage I/O and durable managed-asset accounting. Reserved, active,
# deleting, and delete-pending assets retain quota until backend deletion succeeds.
STORAGE_ASGI_MAX_CONCURRENCY=4
STORAGE_ASGI_ADMISSION_TIMEOUT_SECONDS=5
STORAGE_ASGI_OPERATION_TIMEOUT_SECONDS=120
ASSET_QUOTA_OWNER_MAX_COUNT=100
ASSET_QUOTA_OWNER_MAX_BYTES=5368709120
ASSET_QUOTA_GLOBAL_MAX_COUNT=400
ASSET_QUOTA_GLOBAL_MAX_BYTES=21474836480
ASSET_RESERVATION_LEASE_SECONDS=300
ASSET_RESERVATION_HEARTBEAT_SECONDS=30
ASSET_DELETE_LEASE_SECONDS=180
ASSET_DELETE_RETRY_BASE_SECONDS=60
ASSET_DELETE_RETRY_MAX_SECONDS=3600
JOB_STORAGE_MAX_OUTPUT_COUNT=25
JOB_STORAGE_MAX_OUTPUT_BYTES=2147483648
JOB_STORAGE_MAX_MATERIALIZE_BYTES=2147483648

# Signed local downloads. The secret must contain at least 32 characters.
# Standalone loopback example. Portal deployments must set the externally
# reachable origin that routes /download/* to this service.
PUBLIC_BASE_URL=http://127.0.0.1:8087
DOWNLOAD_SIGNING_SECRET=
DOWNLOAD_URL_TTL_SECONDS=3600

# Exact-host HTTPS ingest only; HTTP and unrestricted-domain modes are unsupported.
MAX_INGEST_BYTES=500000000
MAX_OUTPUT_BYTES=500000000
MAX_DURATION_SECONDS=3600
INGEST_TIMEOUT_SECONDS=300
INGEST_STREAM_CHUNK_BYTES=65536
INGEST_RANGE_CHUNK_BYTES=8388608
INGEST_MAX_REDIRECTS=3
INGEST_ALLOW_HTTP=false
INGEST_ALLOW_ANY_PUBLIC_DOMAIN=false
ALLOWED_DOMAINS=cdn.discordapp.com,media.discordapp.net,drive.usercontent.google.com,drive.google.com,docs.google.com
ALLOWED_CONTENT_TYPES=video/*,audio/*,image/*,application/octet-stream
ALLOW_IMAGE_INGEST=true

# Retention and bounded processing
ASSET_TTL_HOURS=24
MAX_ASSET_TTL_HOURS=168
JOB_TTL_HOURS=24
# Atomic admission spans every configured queue. The execution buffer must cover
# the largest configured job timeout plus the worker's 60-second RQ margin.
JOB_ADMISSION_OWNER_MAX_ACTIVE=4
JOB_ADMISSION_GLOBAL_MAX_ACTIVE=32
JOB_ADMISSION_OWNER_RPM=30
JOB_ADMISSION_EXECUTION_BUFFER_SECONDS=3720
METRICS_TTL_SECONDS=86400
BRAND_KIT_MAX_COUNT=25
BRAND_KIT_MAX_SERIALIZED_BYTES=16384
BRAND_KIT_MAX_STRING_CHARS=256
CLEANUP_INTERVAL_SECONDS=900
JOB_STALE_SECONDS=0
FFMPEG_TIMEOUT_SECONDS=900
FFPROBE_TIMEOUT_SECONDS=60
# Native media subprocess containment. Memory values are bytes; CPU values are seconds.
FFMPEG_RLIMIT_AS_BYTES=3221225472
FFPROBE_RLIMIT_AS_BYTES=536870912
FFMPEG_RLIMIT_CPU_SECONDS=1800
FFPROBE_RLIMIT_CPU_SECONDS=60
MEDIA_RLIMIT_NOFILE=256
FFMPEG_THREADS=2
# Every probed stream and planned output must fit these geometry, rate, and decoded-work ceilings.
MAX_FRAME_WIDTH=8192
MAX_FRAME_HEIGHT=8192
MAX_FRAME_PIXELS=33177600
MAX_MEDIA_STREAMS=16
MAX_VIDEO_FPS=120
MAX_AUDIO_CHANNELS=8
MAX_AUDIO_SAMPLE_RATE=192000
MAX_DECODED_VIDEO_PIXEL_FRAMES=250000000000
MAX_DECODED_AUDIO_SAMPLE_CHANNELS=6000000000
MAX_CONCAT_CLIPS=20
MAX_SLIDESHOW_IMAGES=60
MAX_AUDIO_TRACKS=8
MAX_TEMPLATE_LAYERS=12
MAX_TEMPLATE_TEXT_LAYERS=6
MAX_WORKFLOW_NODES=40
MAX_BATCH_ASSETS=50
MAX_BATCH_PRESETS=12
MAX_BATCH_OPERATIONS=100
MAX_RENDER_ITERATIONS=5
MAX_CAPTION_WORD_TIMINGS=2000

# Local font and logo allowlists
FONT_DIRS=/usr/share/fonts/truetype/dejavu
FONT_ALLOWLIST=
FONT_DEFAULT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
LOGO_DIR=/data/logos
LOGO_ALLOWLIST=

# Optional Google Drive integration, disabled until exact IDs are allowlisted.
GOOGLE_DRIVE_INGEST_ENABLED=false
GOOGLE_DRIVE_EXPORT_ENABLED=false
GOOGLE_DRIVE_ALLOWED_FILE_IDS=
GOOGLE_DRIVE_ALLOWED_FOLDER_IDS=
GOOGLE_DRIVE_CREDENTIALS_PATH=
GOOGLE_DRIVE_IMPERSONATE_USER=
GOOGLE_DRIVE_FOLDER_DEFAULT=

# Optional Discord export. Standalone mode uses the deployment token and exact
# channel allowlist below. Portal mode ignores both and requires the calling
# user's request-scoped BYOK token from the protected broker header.
DISCORD_EXPORT_ENABLED=false
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_BOT_TOKEN=
MCP_DISCORD_TOKEN_HEADER=X-Discord-Bot-Token
DISCORD_MAX_UPLOAD_BYTES=25000000
DISCORD_MAX_RESPONSE_BYTES=1000000
DISCORD_HTTP_TIMEOUT_SECONDS=60

# Logging and immutable release provenance. Catalog 2026-07-18.4 is compiled in.
MCP_LOG_REQUESTS=false
MCP_LOG_LEVEL=INFO
MCP_LOG_STRUCTURED=true
MCP_BUILD_SHA=development
MCP_SOURCE_FINGERPRINT=development
MCP_IMAGE_REFERENCE=development
MCP_IMAGE_VERSION=1.0.1

# Portal Compose only: pre-existing private broker network.
MCP_PORTAL_NETWORK=

# Immutable release Compose only: sha256 digest without the prefix.
MCP_RELEASE_DIGEST=
